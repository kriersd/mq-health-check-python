[Unit]
Description=IBM MQ health agent for F5 BIG-IP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a non-root user in the mqm group so it can read qm.ini and the keystore stash.
User=mqhealth
Group=mqm
# MQHEALTH_REST_PASSWORD=...  and  MQHEALTH_CLIENT_PASSWORD=...  (chmod 600)
EnvironmentFile=/etc/mq-health-agent/secrets.env
# Needed by pymqi for the client_connect check.
Environment=LD_LIBRARY_PATH=/opt/mqm/lib64
ExecStart=/usr/bin/python3 /opt/mq-health-agent/mq_health_agent.py --config /etc/mq-health-agent/config.yaml
# If the agent stops, the F5 marks this member down - restart quickly.
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
