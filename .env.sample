# ==============================================================================
# Filename: .env.sample
# Purpose: Complete configuration file for the IBM MQ Health Check (Python).
#
# This is the ONLY configuration file needed.
# There is no separate config.properties — all settings live here.
#
# Instructions:
#   cp .env.sample .env
#   # Edit .env with your values — never commit .env to source control.
#
# Priority order (highest wins):
#   OS environment variables  >  .env file values  >  built-in defaults
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Branding & Server
# ------------------------------------------------------------------------------
APP_NAME=IBM MQ High-Availability Monitor
APP_ENV=Production
PORT=8080

# ------------------------------------------------------------------------------
# IBM MQ Connection
# ------------------------------------------------------------------------------
MQ_HOST=mq-server.example.com          # Hostname or IP of the MQ server
MQ_PORT=1414                            # MQ Listener port
MQ_CHANNEL=APP.SVRCONN                  # SVRCONN channel name
MQ_QUEUE_MANAGER=QM1                    # Queue Manager name
MQ_TEST_QUEUE=HEALTH.CHECK.TEST         # Queue used by the test_queue check
MQ_DLQ_NAME=SYSTEM.DEAD.LETTER.QUEUE   # Dead Letter Queue for depth check

# ------------------------------------------------------------------------------
# Security Credentials  (SENSITIVE — set only in .env, never in source control)
# ------------------------------------------------------------------------------
MQ_USERNAME=mq_app_user
MQ_PASSWORD=

# ------------------------------------------------------------------------------
# TLS / SSL  (leave blank for plain TCP)
# ------------------------------------------------------------------------------
MQ_SSL_CIPHER_SUITE=                   # e.g. TLS_RSA_WITH_AES_128_CBC_SHA256
MQ_KEYSTORE_PATH=                       # PEM or PKCS12 file for cert expiry check
MQ_KEYSTORE_PASSWORD=                   # PKCS12 password (leave blank for PEM)

# Optional TLS for the HTTP health server itself (F5 HTTPS monitor)
# TLS_CERT_PATH=/etc/mq-health-check/tls/cert.pem
# TLS_KEY_PATH=/etc/mq-health-check/tls/key.pem

# ------------------------------------------------------------------------------
# Host-Local Paths  (used for checks that run directly on the MQ host)
# ------------------------------------------------------------------------------
MQ_INI_PATH=/var/mqm/qmgrs/QM1/qm.ini  # qm.ini for max_channels check
MQ_DATA_PATH=/var/mqm                   # Filesystem path for disk_space check

# ------------------------------------------------------------------------------
# LDAP Reachability  (comma-separated host:port — leave blank to skip)
# ------------------------------------------------------------------------------
# CHECK_LDAP_SERVERS=ldap1.example.com:636,ldap2.example.com:636
# CHECK_LDAP_TIMEOUT=3

# ------------------------------------------------------------------------------
# 12 Health Check Enable/Disable Switches
# true  = check is active
# false = check is skipped entirely
# ------------------------------------------------------------------------------
CHECK_LISTENER_ENABLED=true
CHECK_QMGR_CONNECT_ENABLED=true
CHECK_CLIENT_CONNECT_ENABLED=true
CHECK_MAX_CHANNELS_ENABLED=true
CHECK_DISK_SPACE_ENABLED=true
CHECK_CERT_EXPIRY_ENABLED=true
CHECK_TEST_QUEUE_ENABLED=true
CHECK_DLQ_DEPTH_ENABLED=true
CHECK_APP_QUEUE_DEPTH_ENABLED=true
CHECK_LDAP_ENABLED=true
CHECK_CHANNEL_STATUS_ENABLED=true
CHECK_HOST_RESOURCES_ENABLED=true

# ------------------------------------------------------------------------------
# F5 Severity Overrides
# member_failure  ->  HTTP 503  ->  F5 drops this pool member immediately
# pool_failure    ->  HTTP 200 DEGRADED  ->  F5 keeps member active (no cascade)
# Defaults are set in the application; only uncomment to override.
# ------------------------------------------------------------------------------
# CHECK_LISTENER_SEVERITY=member_failure
# CHECK_QMGR_CONNECT_SEVERITY=member_failure
# CHECK_CLIENT_CONNECT_SEVERITY=member_failure
# CHECK_MAX_CHANNELS_SEVERITY=member_failure
# CHECK_DISK_SPACE_SEVERITY=member_failure
# CHECK_CERT_EXPIRY_SEVERITY=member_failure
# CHECK_TEST_QUEUE_SEVERITY=pool_failure
# CHECK_DLQ_DEPTH_SEVERITY=pool_failure
# CHECK_APP_QUEUE_DEPTH_SEVERITY=pool_failure
# CHECK_LDAP_SEVERITY=pool_failure
# CHECK_CHANNEL_STATUS_SEVERITY=pool_failure
# CHECK_HOST_RESOURCES_SEVERITY=member_failure

# ------------------------------------------------------------------------------
# Thresholds & Limits
# ------------------------------------------------------------------------------
CHECK_DLQ_DEPTH_THRESHOLD=10             # DEGRADED when DLQ exceeds this depth
CHECK_APP_QUEUE_DEPTH_THRESHOLD_PCT=90   # DEGRADED when queue exceeds this % of MaxDepth
CHECK_HOST_RESOURCES_CPU_LIMIT=95        # Reserved — CPU limit %

# Application queues to check depth on (comma-separated queue names)
CHECK_APP_QUEUE_DEPTH_QUEUES=DEV.QUEUE.1,DEV.QUEUE.2

# Channels to verify status for (comma-separated)
CHECK_CHANNEL_STATUS_CHANNELS=APP.SVRCONN
